  m_text: "\u041F\u043E\u043B\u0438\u0432\u0430\u0439\u0442\u0435 7 \u0434\u043D\u0435\u0439
    \u0441 \u043C\u043E\u043C\u0435\u043D\u0442\u0430 \u043F\u043E\u0441\u0430\u0434\u043A\u0438,
    \u0438\u043D\u0430\u0447\u0435 \u0446\u0432\u0435\u0442\u043E\u043A \u0437\u0430\u0441\u043E\u0445\u043D\u0435\u0442.\r\n\u041D\u0430
    \u0444\u0438\u043D\u0430\u043B\u044C\u043D\u043E\u0439 \u0441\u0442\u0430\u0434\u0438\u0438
    \u0440\u043E\u0441\u0442\u0430 \u0432\u044B\u0440\u0430\u0449\u0438\u0432\u0430\u0435\u0442
    \u043D\u0430 \u0441\u0432\u043E\u0431\u043E\u0434\u043D\u044B\u0445 \u043A\u043B\u0435\u0442\u043A\u0430\u0445
    \u0446\u0432\u0435\u0442\u044B, \u0433\u043E\u0442\u043E\u0432\u044B\u0435 \u043A
    \u0441\u0431\u043E\u0440\u0443."
